# Apex Legends API key — get one at https://apexlegendsapi.com/
# IMPORTANT: verify the key by linking your Discord at
# https://portal.apexlegendsapi.com/discord-auth (required before any data)
APEX_API_KEY=your_key_here

# SQLite database file path
DB_PATH=data/apex.db

# Snapshot polling interval (minutes)
SNAPSHOT_INTERVAL_MIN=10

# Default platform for new players (PC / PS4 / X1)
PLATFORM_DEFAULT=PC

# Display name shown in the banner (overrides the empty upstream name).
# Set once here — survives redeploys.
DISPLAY_NAME=YourName

# Admin token for /admin (EA data export upload & reconciliation).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(24))"
# Leave empty to disable the admin surface entirely.
ADMIN_TOKEN=
